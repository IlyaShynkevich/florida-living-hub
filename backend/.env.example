# Port the API listens on. Defaults to 3001 if unset.
# Most hosts (Render, Heroku, Fly) assign this automatically — leave it unset there.
# PORT=3001

# Set to "production" when deploying. This turns off the automatic
# http://localhost:5173 CORS allowance, which makes CORS_ORIGINS mandatory.
# NODE_ENV=production

# Comma-separated list of browser origins allowed to call this API.
#
# Dev:  optional. http://localhost:5173 is allowed automatically; add entries
#       here only to reach the API from another device, e.g.
#       CORS_ORIGINS=http://192.168.0.116:5173
# Prod: REQUIRED. With NODE_ENV=production there is no default origin and the
#       server throws at boot if this is empty. Point it at the deployed
#       frontend, e.g.
#       CORS_ORIGINS=https://florida-living-hub-web.onrender.com
# CORS_ORIGINS=

# Open-Meteo pipeline tuning. All optional — defaults shown.
# WEATHER_REFRESH_MINUTES=20
# WEATHER_TIMEOUT_MS=15000
# WEATHER_RETRY_MINUTES=2
